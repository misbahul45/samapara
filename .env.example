# ============================================
# SAMPARA — template environment development
# Cara pakai:
#   cp .env.example .env
# (.env di-gitignore — jangan pernah di-commit)

# --- Port GATEWAY (nginx) di host ---
# Satu-satunya entry point ke semua service (gateway-only).
# Service app tidak di-publish ke host, hanya di internal network samapara_net.
GATEWAY_PORT=8090

# --- PostgreSQL + TimescaleDB (satu service) ---
POSTGRES_DB=samapara
POSTGRES_USER=samapara
POSTGRES_PASSWORD=samapara_dev_password

# --- Redis (Streams) ---
REDIS_PASSWORD=samapara_dev_redis

# --- Qdrant (vector DB, TurboQuant) ---
QDRANT_API_KEY=samapara_dev_qdrant_admin
QDRANT_READ_ONLY_API_KEY=samapara_dev_qdrant_readonly
QDRANT_COLLECTION=samapara_knowledge
EMBEDDING_DIM=384

# --- MinIO (dev only; production = S3 eksternal) ---
MINIO_ROOT_USER=samapara
MINIO_ROOT_PASSWORD=samapara_dev_minio_password

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- MQTT ---
MQTT_HOST=mosquitto
MQTT_PORT=1883

# --- Connection strings (dipakai app service di dalam network) ---
DATABASE_URL=postgresql://samapara:samapara_dev_password@postgres:5432/samapara
REDIS_URL=redis://:samapara_dev_redis@redis:6379/0
QDRANT_URL=http://qdrant:6333
