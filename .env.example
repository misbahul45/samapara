# ============================================
# SAMPARA — template environment development
# Cara pakai:
#   cp .env.example .env
# (.env di-gitignore — jangan pernah di-commit)

# --- Port mapping HOST (port dalam container sudah tetap) ---
# Hindari bentrok dengan service lain yang sedang jalan di host
# (contoh: container bemunair memakai 3000/3001/8080/8002).
CONTROLL_PORT=3100        # apps/samapara_controll   (Nuxt)    :3000
API_PLATFORM_PORT=3200    # services/api_platform    (Hono)    :3000
DECISION_ENGINE_PORT=3300 # services/decision_engine (FastAPI) :8000
TELEMETRY_PORT=3400       # services/telemetry_worker (Gin)    :8080

# --- Tambahkan secret / konfigurasi lain di sini ---
# Contoh:
# DATABASE_URL=
# API_KEY=
