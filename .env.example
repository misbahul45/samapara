# ============================================
# SAMPARA — template environment development
# Cara pakai:
#   cp .env.example .env
# (.env di-gitignore — jangan pernah di-commit)

# --- Port GATEWAY (nginx) di host ---
# Satu-satunya entry point ke semua service (gateway-only).
# Service app tidak di-publish ke host, hanya di internal network samapara_net.
GATEWAY_PORT=8090

# --- PostgreSQL + TimescaleDB (satu service) ---
# POSTGRES_USER = superuser container (dev only; owner praktis untuk dev).
POSTGRES_DB=samapara
POSTGRES_USER=samapara
POSTGRES_PASSWORD=samapara_dev_password

# --- PostgreSQL roles (least privilege) ---
# owner      : Prisma CLI / migration (DDL only)
# app        : Hono / Prisma runtime (CRUD public+gold)
# ingestor_ro: Go telemetry_worker (read-only devices)
# ai         : Python decision_engine (telemetry + forecast + RAG)
POSTGRES_OWNER_USER=samapara_owner
POSTGRES_OWNER_PASSWORD=samapara_owner_dev_password
POSTGRES_APP_USER=samapara_app
POSTGRES_APP_PASSWORD=samapara_app_dev_password
POSTGRES_INGESTOR_USER=samapara_ingestor_ro
POSTGRES_INGESTOR_PASSWORD=samapara_ingestor_dev_password
POSTGRES_AI_USER=samapara_ai
POSTGRES_AI_PASSWORD=samapara_ai_dev_password

# --- Redis (Streams) ---
REDIS_PASSWORD=samapara_dev_redis

# --- Qdrant (vector DB, TurboQuant) ---
QDRANT_API_KEY=samapara_dev_qdrant_admin
QDRANT_READ_ONLY_API_KEY=samapara_dev_qdrant_readonly
QDRANT_COLLECTION=samapara_knowledge
EMBEDDING_DIM=384

# --- MinIO (dev only; production = S3 eksternal) ---
MINIO_ROOT_USER=samapara
MINIO_ROOT_PASSWORD=samapara_dev_minio_password

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- MQTT ---
MQTT_HOST=mosquitto
MQTT_PORT=1883

# --- Internal service auth (Bearer antar service, minimal 32 byte) ---
INTERNAL_SERVICE_TOKEN=samapara_dev_internal_token_9f8e7d6c5b4a3210

# --- Public JWT (auth fase lanjutan) ---
JWT_SECRET=samapara_dev_jwt_secret_8f7e6d5c4b3a2109

# --- Origin publik untuk CORS Hono ---
PUBLIC_ORIGINS=http://localhost:8090,http://localhost:8081

# --- Connection strings (dipakai app service di dalam network) ---
# Prisma CLI / migration (owner role)
PRISMA_DATABASE_URL=postgresql://samapara_owner:samapara_owner_dev_password@postgres:5432/samapara
# Hono runtime (app role)
DATABASE_URL=postgresql://samapara_app:samapara_app_dev_password@postgres:5432/samapara
# Go ingestor (read-only role)
GO_DATABASE_URL=postgresql://samapara_ingestor_ro:samapara_ingestor_dev_password@postgres:5432/samapara
# Python decision_engine (ai role) — di-override per-service di compose
# DATABASE_URL_AI=postgresql://samapara_ai:samapara_ai_dev_password@postgres:5432/samapara

REDIS_URL=redis://:samapara_dev_redis@redis:6379/0
QDRANT_URL=http://qdrant:6333

# --- URL antar service (internal network, TIDAK lewat nginx) ---
DECISION_ENGINE_URL=http://decision_engine:8000
TELEMETRY_WORKER_URL=http://telemetry_worker:8080
