# ============================================================
# SAMPARA — ROOT .gitignore
# ============================================================
#
# Yang TETAP di-track:
# - pnpm-lock.yaml
# - uv.lock
# - go.sum
# - go.mod
# - package.json
# - pyproject.toml
# - prisma/schema.prisma
# - prisma/migrations/**
# - Dockerfile
# - docker-compose*.yml
# - compose*.yml
# - infra configuration
# - SQL migrations / init scripts
# - .env.example
#
# Jangan commit:
# - secrets
# - env nyata
# - dependencies
# - generated files
# - build outputs
# - runtime data
# - DB dumps
# - local container storage
# - logs
# - certificates/private keys
# ============================================================


# ============================================================
# ENV / SECRETS
# ============================================================

.env
.env.*
!.env.example
!**/.env.example

*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

.envrc
.direnv/

secrets/
**/secrets/

.secret/
**/.secret/

credentials/
**/credentials/

*.secret
*.secrets


# ============================================================
# PRIVATE KEYS / CERTIFICATES
# ============================================================

*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

*.kubeconfig

infra/**/certs/
infra/**/certificates/
infra/**/private/

certs/
certificates/


# ============================================================
# NODE.JS
# Nuxt / Hono / Expo / TypeScript
# ============================================================

node_modules/
**/node_modules/

.pnpm-store/
**/.pnpm-store/

.npm/
**/.npm/

.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

.npmrc.local
.pnpmfile.local.cjs


