# ============================================================
# SAMPARA services/api_platform — development image (hot reload)
#
# - pnpm 11.18.0 via corepack (lockfileVersion 9.0)
# - Dev command: `pnpm dev` = tsx watch src/index.ts (auto restart)
# - Source TIDAK di-copy: di-bind mount oleh docker-compose.dev.yml
# ============================================================
FROM node:22-slim

RUN corepack enable && corepack prepare pnpm@11.18.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

EXPOSE 3000

CMD ["pnpm", "dev"]
