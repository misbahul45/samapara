# ============================================================
# SAMPARA services/decision_engine — development image (hot reload)
#
# - Python 3.14 + uv (sesuai .python-version dan uv.lock)
# - Dev command: uvicorn --reload (auto restart saat file berubah)
# - Source TIDAK di-copy: di-bind mount oleh docker-compose.dev.yml
# - .venv dibuat di sini dan mengisi named volume decision_venv
# ============================================================
FROM python:3.14-slim

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
COPY README.md ./
COPY src/ ./src/
RUN uv sync --frozen --no-dev

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "decision_engine.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
